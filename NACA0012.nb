Cell["Read values of the solution", "Title",
  FontFamily->"Courier",
  FontSize->24],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(fn = "\<~/Documents/NACA0012/NACA0012.out\>";\)\)], "Input"],

Cell[BoxData[
    \(\(stream1 = OpenRead[fn];\)\)], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
    \(n4 = Read[stream1, Number]\)], "Input"],

Cell[BoxData[
    \(3034\)], "Output"]
}, Open  ]],

Cell[BoxData[
    \(\(frm = Table[Real, {n4}];\)\)], "Input"],

Cell[BoxData[
    \(\(r = Read[stream1, frm];\)\)], "Input"],

Cell[BoxData[
    \(\(Close[stream1];\)\)], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Dimensions[r]\)], "Input"],

Cell[BoxData[
    \({3034}\)], "Output"]
}, Open  ]]
}, Open  ]],

Cell["Normalization of values of solution", "Subtitle",
  FontFamily->"Courier"],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(m1 = Min[r];\)\)], "Input"],

Cell[BoxData[
    \(\(r = r - m1;\)\)], "Input"],

Cell[BoxData[
    \(\(m1 = Max[r];\)\)], "Input"],

Cell[BoxData[
    \(\(r = r/m1;\)\)], "Input"],

Cell[BoxData[
    \(\(r2 = 
        Table[\((r[\([tr[\([i, 1]\)]]\)] + r[\([tr[\([i, 2]\)]]\)] + 
                r[\([tr[\([i, 3]\)]]\)])\)/3.0, {i, 
            Length[tr]}];\)\)], "Input"]
}, Open  ]],

Cell["Make Colored polygon", "Subtitle",
  FontFamily->"Courier"],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(p3 = 
        Table[{\((p1[\([tr[\([i, 1]\)]]\)] + 
                  p1[\([tr[\([i, 2]\)]]\)])\)*0.5, \((p1[\([tr[\([i, 
                          2]\)]]\)] + 
                  p1[\([tr[\([i, 3]\)]]\)])\)*0.5, \((p1[\([tr[\([i, 
                          3]\)]]\)] + p1[\([tr[\([i, 1]\)]]\)])\)*0.5}, {i, 
            Length[tr]}];\)\)], "Input"],

Cell[BoxData[
    \(\(plg = 
        Table[{{Hue[r[\([tr[\([i, 1]\)]]\)]], 
              Polygon[{p2[\([i, 1]\)], p3[\([i, 1]\)], 
                  p3[\([i, 3]\)]}]}, {Hue[r2[\([i]\)]], 
              Polygon[{p3[\([i, 1]\)], p3[\([i, 2]\)], 
                  p3[\([i, 3]\)]}]}, {Hue[r[\([tr[\([i, 2]\)]]\)]], 
              Polygon[{p2[\([i, 2]\)], p3[\([i, 2]\)], 
                  p3[\([i, 1]\)]}]}, {Hue[r[\([tr[\([i, 3]\)]]\)]], 
              Polygon[{p2[\([i, 3]\)], p3[\([i, 3]\)], 
                  p3[\([i, 2]\)]}]}}, {i, Length[tr]}];\)\)], "Input"]
}, Open  ]],

Cell["Draw the result", "Subtitle",
  FontFamily->"Courier"],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(Show[Graphics[plg], 
        PlotRange \[Rule] {{\(- .25\), 1.25}, {\(-1\), 1}}, 
        AspectRatio \[Rule] 2/1.5];\)\)], "Input"],

