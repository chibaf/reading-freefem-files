Notebook[{
Cell["read mesh and make Graphics primitives", "Title",
  FontFamily->"Courier",
  FontSize->24],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(fn = "\<~/Documents/NACA0012/NACA0012.msh\>";\)\)], "Input"],

Cell[CellGroupData[{

Cell[BoxData[{
    \(\(stream1 = OpenRead[fn];\)\), "\n", 
    \({n1, n2, n3} = Read[stream1, {Number, Number, Number}]\)}], "Input"],

Cell[BoxData[
    \({3034, 5876, 192}\)], "Output"]
}, Open  ]],

Cell[BoxData[
    \(\(frm = Table[{Real, Real, Number}, {n1}];\)\)], "Input"],

Cell[BoxData[
    \(\(p = Read[stream1, frm];\)\)], "Input"],

Cell[BoxData[
    \(\(p1 = 
        Table[{p[\([i, 1]\)], p[\([i, 2]\)]}, {i, Length[p]}];\)\)], "Input"],

Cell[BoxData[
    \(\(frm = Table[{Number, Number, Number, Number}, {n2}];\)\)], "Input"],

Cell[BoxData[
    \(\(tr = Read[stream1, frm];\)\)], "Input"],

Cell[BoxData[
    \(\(tr1 = 
        Table[{tr[\([i, 1]\)], tr[\([i, 2]\)], tr[\([i, 3]\)], 
            tr[\([i, 1]\)]}, {i, Length[tr]}];\)\)], "Input"],

Cell[BoxData[
    \(\(frm = Table[{Number, Number, Number}, {n3}];\)\)], "Input"],

Cell[BoxData[
    \(\(vt = Read[stream1, frm];\)\)], "Input"],

Cell[BoxData[
    \(\(Close[stream1];\)\)], "Input"],

Cell[BoxData[
    \(\(p2 = Map[p1[\([#]\)] &, tr1];\)\)], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
    \(p2[\([1]\)]\)], "Input"],

Cell[BoxData[
    \({{0.942677280347`, \(-0.0245888573347`\)}, {0.926947073477`, \
\(-0.0261184093786`\)}, {0.932552992769`, \(-0.0433022152104`\)}, \
{0.942677280347`, \(-0.0245888573347`\)}}\)], "Output"]
}, Open  ]],

Cell[BoxData[
    \(\(lp1 = Map[Line, p2];\)\)], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(Show[Graphics[lp1], AspectRatio \[Rule] 1, 
        PlotRange \[Rule] All];\)\)], "Input"],

